function Set-Firewall {
    param([string]$Mode)
    
    Write-Log "=== Firewall ===" "INFO"
    
    $profiles = Get-NetFirewallProfile
    foreach ($profile in $profiles) {
        Write-Log "$($profile.Name): Enabled=$($profile.Enabled)"
    }
    
    if ($Mode -eq 'Enforce') {
        if (Show-Confirmation "Enable firewall for all profiles?") {
            Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled True
            Write-Log "Firewall enabled" "INFO"
        }
    }
}

function Set-WindowsDefender {
    param([string]$Mode)
    
    Write-Log "=== Windows Defender ===" "INFO"
    
    $status = Get-MpComputerStatus -ErrorAction SilentlyContinue
    if ($status) {
        Write-Log "RealTime Protection: $($status.RealTimeProtectionEnabled)"
        
        if ($Mode -eq 'Enforce' -and -not $status.RealTimeProtectionEnabled) {
            if (Show-Confirmation "Enable Windows Defender?") {
                Set-MpPreference -DisableRealtimeMonitoring $false
                Write-Log "Defender enabled" "INFO"
            }
        }
    }
}

# --- NEW HARDENING FUNCTIONS ---

function Set-AuditPolicy {
    param([string]$Mode)
    
    Write-Log "=== Audit Policy ===" "INFO"
    $script:ComplianceReport['AuditPolicy'] = @{}
    
    # In Audit mode, we'll just check one setting
    if ($Mode -eq 'Audit') {
        try {
            $logon = auditpol /get /subcategory:"Logon" /r | ConvertFrom-Csv
            if ($logon.'Inclusion Setting' -notlike "*Success and Failure*") {
                 Write-Log "Audit policy for Logon is not set to Success and Failure." "WARN"
                 $script:ComplianceReport['AuditPolicy']['Status'] = "Non-Compliant"
            } else {
                 Write-Log "Audit policy for Logon is compliant." "INFO"
                 $script:ComplianceReport['AuditPolicy']['Status'] = "Compliant"
            }
        } catch {
             Write-Log "Could not audit policy (auditpol.exe failed)." "ERROR"
        }
    }
    elseif ($Mode -eq 'Enforce') {
        if (Show-Confirmation "Enable advanced audit policies? (Logon, Account Logon, Policy Change)") {
            try {
                Write-Log "Enforcing audit policies..."
                auditpol /set /subcategory:"Logon" /success:enable /failure:enable 2>&1 | Out-Null
                auditpol /set /subcategory:"Account Logon" /success:enable /failure:enable 2>&1 | Out-Null
                auditpol /set /subcategory:"Other Logon/Logoff Events" /success:enable /failure:enable 2>&1 | Out-Null
                auditpol /set /subcategory:"Policy Change" /success:enable /failure:enable 2>&1 | Out-Null
                Write-Log "Advanced audit policies enforced." "INFO"
                $script:ComplianceReport['AuditPolicy']['Status'] = "Enforced"
            } catch {
                 Write-Log "Failed to enforce audit policies: $($_.Exception.Message)" "ERROR"
            }
        }
    }
}

function Set-SystemHardening {
    param([string]$Mode)
    Write-Log "=== System Hardening ===" "INFO"
    $script:ComplianceReport['SystemHardening'] = @{}
    
    # 1. Disable SMBv1
    try {
        $smb = Get-WindowsOptionalFeature -Online -FeatureName SMB1Protocol -ErrorAction SilentlyContinue
        if ($smb -and $smb.State -eq 'Enabled') {
            Write-Log "SMBv1 is enabled." "WARN"
            if ($Mode -eq 'Enforce') {
                if (Show-Confirmation "Disable SMBv1 Protocol? (Highly Recommended, requires reboot)") {
                    Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol -NoRestart -ErrorAction Stop
                    Write-Log "SMBv1 has been disabled. A reboot is required." "WARN"
                    $script:ComplianceReport['SystemHardening']['SMBv1'] = "Enforced"
                }
            }
        } else {
             Write-Log "SMBv1 is already disabled or not present." "INFO"
             $script:ComplianceReport['SystemHardening']['SMBv1'] = "Compliant"
        }
    } catch {
        Write-Log "Error checking/disabling SMBv1: $($_.Exception.Message)" "ERROR"
    }

    # 2. Disable Remote Registry
    try {
        $svc = Get-Service -Name "RemoteRegistry" -ErrorAction SilentlyContinue
        if ($svc -and $svc.StartType -ne 'Disabled') {
            Write-Log "Remote Registry service is not disabled." "WARN"
            if ($Mode -eq 'Enforce') {
                if (Show-Confirmation "Disable and Stop Remote Registry service?") {
                    Set-Service -Name "RemoteRegistry" -StartupType Disabled -Status Stopped
                    Write-Log "Remote Registry service disabled and stopped." "INFO"
                    $script:ComplianceReport['SystemHardening']['RemoteRegistry'] = "Enforced"
                }
            }
        } else {
            Write-Log "Remote Registry service is already disabled." "INFO"
            $script:ComplianceReport['SystemHardening']['RemoteRegistry'] = "Compliant"
        }
    } catch {
         Write-Log "Error checking/disabling Remote Registry: $($_.Exception.Message)" "ERROR"
    }

    # 3. Enable UAC
    try {
        $lua = Get-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" -Name "EnableLUA" -ErrorAction SilentlyContinue
        if ($lua -and $lua.EnableLUA -ne 1) {
            Write-Log "UAC (EnableLUA) is disabled." "WARN"
            if ($Mode -eq 'Enforce') {
                if (Show-Confirmation "Enable UAC (User Account Control)?") {
                    Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" -Name "EnableLUA" -Value 1 -ErrorAction Stop
                    Set-ItemProperty -Path "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System" -Name "ConsentPromptBehaviorAdmin" -Value 5 -ErrorAction Stop
                    Write-Log "UAC has been enabled." "INFO"
                    $script:ComplianceReport['SystemHardening']['UAC'] = "Enforced"
                }
            }
        } else {
             Write-Log "UAC is already enabled." "INFO"
             $script:ComplianceReport['SystemHardening']['UAC'] = "Compliant"
        }
    } catch {
         Write-Log "Error checking/enabling UAC: $($_.Exception.Message)" "ERROR"
    }
}

