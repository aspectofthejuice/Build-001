function Update-AllApplications {
    <#
    .SYNOPSIS
        Runs Chocolatey update only. Prompts to install Choco if not found.
    #>
    Write-Log "=== Updating All Chocolatey Apps ===" "INFO"

    $chocoPath = "C:\ProgramData\chocolatey\choco.exe"
    $installRequired = -not (Test-Path $chocoPath)
    
    # 1. INSTALL CHOCOLATEY IF NEEDED
    if ($installRequired) {
        Write-Log "Chocolatey not installed." "WARN"
        if (Show-Confirmation "Chocolatey not found. Install it now to update third-party apps?") {
            Write-Log "Attempting to install Chocolatey..."
            try {
                Set-ExecutionPolicy Bypass -Scope Process -Force
                [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072
                $installScript = (New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1')
                Invoke-Expression $installScript
                
                Write-Log "Chocolatey installation script executed." "INFO"
                Start-Sleep -Seconds 3 # Wait a moment for file system changes
                
            } catch {
                Write-Log "Failed to install Chocolatey: $($_.Exception.Message)" "ERROR"
            }
        }
    }
    
    # 2. RUN UPDATE IN A NEW SHELL FOR STABLE ENVIRONMENT
    if (Test-Path $chocoPath) {
        Write-Log "Chocolatey found. Attempting to update all Chocolatey-managed apps in a new shell."
        if (Show-Confirmation "Run 'choco upgrade all' to update all third-party software?") {
            try {
                # This script block will run in a fresh PowerShell instance, ensuring the PATH is loaded.
                $upgradeScriptBlock = {
                    param($LogFile)
                    # Force environment reload one last time just in case
                    $env:PATH = [System.Environment]::GetEnvironmentVariable("Path","Machine") + ";" + [System.Environment]::GetEnvironmentVariable("Path","User")
                    
                    # Execute the upgrade command and pipe output to the log file
                    "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [INFO] Choco: Starting upgrade..." | Out-File $LogFile -Append
                    
                    # Run choco.exe using the path to ensure it's found
                    & "C:\ProgramData\chocolatey\choco.exe" upgrade all -y -r 2>&1 | Out-File $LogFile -Append
                    
                    "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [INFO] Choco: Upgrade command finished." | Out-File $LogFile -Append
                }
                
                # Start the new process and wait for it to complete
                $process = Start-Process powershell.exe -ArgumentList "-ExecutionPolicy Bypass", "-NoProfile", "-WindowStyle Hidden", "-Command", " & $upgradeScriptBlock -LogFile '$script:LogFile' " -Wait -PassThru
                
                Write-Log "Chocolatey upgrade process started (PID: $($process.Id)) and finished." "INFO"
                
            } catch {
                Write-Log "Error running choco upgrade: $($_.Exception.Message)" "ERROR"
            }
        }
    } else {
        Write-Log "Chocolatey not installed. Skipping third-party app update."
    }
}

