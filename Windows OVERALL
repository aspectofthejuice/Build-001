function Get-InstalledApplications {
    <#
    .SYNOPSIS
        Retrieves a list of installed applications.
    #>
    Write-Log "Retrieving installed applications..."
    
    # Paths for 32-bit and 64-bit applications
    $paths = @(
        'HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*'
    )

    $installedApps = @()
    foreach ($path in $paths) {
        try {
            # We need DisplayName and UninstallString (or QuietUninstallString)
            $apps = Get-ItemProperty $path -ErrorAction SilentlyContinue |
                    Where-Object { $_.DisplayName -and ($_.UninstallString -or $_.QuietUninstallString) } |
                    Select-Object DisplayName, UninstallString, QuietUninstallString, Publisher
            $installedApps += $apps
        } catch {
            # FINAL FIX: Wrap $path in subexpression $() to isolate it from the colon, 
            # and explicitly call .Exception.Message to guarantee string context for the error.
            Write-Log "Error reading registry path $($path): $($_.Exception.Message)" "ERROR" 
        }
    }
    
    Write-Log "Found $($installedApps.Count) installed applications."
    return $installedApps | Sort-Object DisplayName
}


